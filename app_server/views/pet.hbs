<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header }}
			{{> login }}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Boarding</h1>
							<ul id="sites">
			{{#each boarding}}
								<li>
									<a href="/pet"><img src="images/{{this.image}}" alt="Img" width="325" height="225"></a>
									<h2><a href="/pet">{{this.name}}</a></h2>
									{{{this.description}}}
								</li>
			{{/each}}
								</li>
								<!--Button to open the modal-->
								<button
									onclick="document.getElementById('id01').style.display='block'">Register</button>

								<!--The Modal (contains the Sign Up form)-->
								<div id="id01" class="modal">
									<span onclick="document.getElementById('id01').style.display='none'" class="close"
										title="Close Modal"></span>
									<!--<form class="modal-content" action="/action_page.php">-->
									<div class='modal-content'>
										<div class="container">
											<h1>Register</h1>
											<p>Please fill in this form to register pet.</p>
											<hr>
											<label for="name"><b>Name</b></label>
											<input type="text" placeholder="Enter Name " name="name" id='rgstr-name' required>

											<label for="adress"><b>Address</b></label>
											<input type="text" placeholder="Enter Address" name="address" id="rgstr-addr" required>

											<label for="phone"><b>Phone Number</b></label>
											<input type="text" placeholder="Enter Phone Number" name="phone" id="rgstr-phone" required>

											<label for="pet-type"><b>Pet Type</b></label>
											<input type="text" placeholder="Enter Type of Pet" name="pet-type" id="rgstr-pet-ty" required>

											<label for="pet-name"><b>Pet Name</b></label>
											<input type="text" placeholder="Enter Name of Pet" name="pet-name" id="rgstr-pet-name" required>

											<label for="email"><b>Email</b></label>
											<input type="email" placeholder="Email" name="email" id="rgstr-email" required>

											<label for="pass"><b>Password</b></label>
											<input type="password" placeholder="Password" name="pass" id="rgstr-pass" required>

											<label>
												<input type="checkbox" checked="checked" name="remember"
													style="margin-bottom:15px">
												Remember me
											</label>

											<p>By creating an account you agree to our <a href="#"
													style="color:dodgerblue">Terms & Privacy</a>.</p>

											<div class="clearfix">
												<button type="button"
													onclick="document.getElementById('id01').style.display='none'"
													class="cancelbtn">Cancel</button>
												<button class="register" id="rgstr-btn">Register</button>
											</div>
										</div>
									</div>
								</div>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>	
		<script>
		// Get the modal
		var modal = document.getElementById('id01');

		// When the user clicks anywhere outside of the modal, close it
		window.onclick = function (event) {
			if (event.target == modal) {
				modal.style.display = "none";
			}
		}
	</script>
	<script src='javascripts/script.js'></script>
</body>
</html>